# Resend (https://resend.com) — used by /api/newsletter/*. Without it, dev logs
# the confirmation email instead of sending; production answers 503.
RESEND_API_KEY=

# Resend Audiences, one per locale (create in the Resend dashboard).
RESEND_AUDIENCE_ID_EN=
RESEND_AUDIENCE_ID_PT=

# Sender for confirmation emails. Until the domain is verified in Resend, leave
# the default (onboarding@resend.dev — delivers only to the account owner).
# After verification: NEWSLETTER_FROM_EMAIL="stoic.log <log@cicatriz.dev>"
NEWSLETTER_FROM_EMAIL=

# Secret for HMAC-signing the double opt-in confirmation tokens.
# Generate one: openssl rand -hex 32
NEWSLETTER_TOKEN_SECRET=

# Google Analytics measurement id (production only; omit to disable).
NEXT_PUBLIC_GA_ID=
